+def password_needs_rehash(encoded):
+    try:
+        parts = encoded.split('$')
+        if parts[0] != 'scrypt':
+            return True
+        _, n, r, p, _, _ = parts
+        if int(n) != SCRYPT_N or int(r) != SCRYPT_R or int(p) != SCRYPT_P:
+            return True
+        return False
+    except Exception:
+        return False
+
